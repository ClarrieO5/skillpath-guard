{
  "name": "skillpath-guard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Offline checks for broken, case-mismatched and non-portable file references in Agent Skills (SKILL.md)",
  "keywords": [
    "agent-skills",
    "skill-md",
    "claude-skills",
    "lint",
    "link-checker",
    "github-action"
  ],
  "homepage": "https://github.com/ClarrieO5/skillpath-guard#readme",
  "bugs": {
    "url": "https://github.com/ClarrieO5/skillpath-guard/issues"
  },
  "bin": {
    "skillpath-guard": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "scan:valid": "node src/cli.mjs scan examples/valid",
    "scan:broken": "node src/cli.mjs scan examples/broken",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClarrieO5/skillpath-guard.git"
  }
}
